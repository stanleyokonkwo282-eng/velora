# Copy this file to `.env` and fill in your own values.
#
# Remember: every VITE_ variable is embedded in the public JavaScript bundle.
# Paystack SECRET keys (sk_*) must only ever live on your server.

VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_VERIFY_URL=
VITE_ADMIN_EMAIL=you@your-domain.com
VITE_SUPPORT_EMAIL=support@your-domain.com
